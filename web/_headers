# Cloudflare Pages — HTTP başlıkları
# Güvenlik başlıkları tüm yollar için (CSP eklenmedi: uygulama inline stil/script kullanır)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# CSS/JS içerik-hash'li adlandırılır (site.<hash>.css) → immutable güvenli, asla bayatlamaz
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Görseller sürümsüz — makul cache (değişirse 1 günde yayılır)
/assets/img/*
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400
